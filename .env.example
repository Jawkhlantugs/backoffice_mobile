# ============================================================
# X-Meta Admin Mobile — орчны хувьсагчид
# ============================================================
# Энэ файлыг `.env.local` нэрээр хуулж, утгыг нь xmeta-admin вэбийн
# `.env`-ээс аваад бөглөнө. `.env.local` нь git-д ОРОХГҮЙ.
#
# Service бүрийн path prefix нь src/core/config/api.ts дотор угсрагдана —
# энд биш.
# ============================================================

# ---------- AWS Cognito (АДМИНЫ pool — хэрэглэгчийн pool биш) ----------
EXPO_PUBLIC_COGNITO_USER_POOL_ID=
EXPO_PUBLIC_COGNITO_CLIENT_ID=
EXPO_PUBLIC_AWS_REGION=ap-southeast-1

# ---------- X-Meta monorepo API (нэг base) ----------
EXPO_PUBLIC_XMETA_API_URL=https://api.x-meta.com/api

# ---------- Хуучин backoffice API ----------
EXPO_PUBLIC_BACKOFFICE_API_URL=https://backoffice-api.x-meta.com/api/v1

# ---------- Partner affiliate API (заавал биш, тусдаа host) ----------
# Хоосон бол Partner цэс "Вэб дээр" гэж идэвхгүй харагдана.
EXPO_PUBLIC_PARTNER_API_URL=https://partners-api.x-meta.com/api/v1/admin/partner

# ---------- WebSocket (support чат) ----------
EXPO_PUBLIC_SUPPORT_WS_URL=wss://api-socket.x-meta.com/ws

# ---------- App Store review-ийн демо нэвтрэлт (заавал биш) ----------
# Хоёулаа бөглөгдсөн үед л ажиллана. Энэ имэйл + нууц үгээр нэвтрэхэд апп
# Cognito, backend руу огт хандахгүй — зохиомол өгөгдөл харуулна.
EXPO_PUBLIC_DEMO_EMAIL=
EXPO_PUBLIC_DEMO_PASSWORD=
