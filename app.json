{
  "expo": {
    "name": "X-Meta Admin",
    "slug": "x-meta-backoffice",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "xmetaadmin",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.xmeta.backoffice",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Админ аппыг нээхэд Face ID ашиглана.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#131426",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.xmeta.backoffice",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f172b",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Админ аппыг нээхэд Face ID ашиглана."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mobile banner-ийн зургийг сонгоход зургийн сан руу хандана.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b2c199c7-667f-47aa-a6c7-5353dfac0932"
      }
    },
    "owner": "x-meta"
  }
}
